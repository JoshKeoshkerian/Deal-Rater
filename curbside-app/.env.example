# Copy to .env.local for local development.
#
# NEXT_PUBLIC_ because this is read in the browser: every call from this site is
# a client-side fetch carrying the session cookie. There is no secret here — the
# API base URL is visible in devtools regardless.
#
# Production (Vercel env var): https://api.curbsidescore.com
# Local: point at a backend running on your machine.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
