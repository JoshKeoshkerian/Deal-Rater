# Copy to backend/.env for local development.

DEAL_RATER_DATABASE_URL=postgresql+psycopg://dealrater:dealrater@localhost:5432/dealrater

# Retention window for observation data (spec 8.2). Rows older than this are
# removed by `python -m app.retention`. Set deliberately; there is no default
# that is right for every deployment.
DEAL_RATER_RETENTION_DAYS=400

# Origins allowed to call the API. The unpacked extension's origin is
# chrome-extension://<id>, printed by chrome://extensions after loading. The
# website's origin goes here too, once it exists.
#
# MUST STAY A LIST OF EXACT ORIGINS. The API now sends credentials
# (allow_credentials=True, for the website's session cookie), and the CORS spec
# forbids that alongside a "*" origin -- Starlette would emit the literal "*"
# and silently break every credentialed request.
DEAL_RATER_CORS_ORIGINS=["chrome-extension://REPLACE_WITH_EXTENSION_ID","https://curbsidescore.com","https://app.curbsidescore.com","http://localhost:3000"]

# Spec 6.6: the one LLM call, for qualitative known issues. This is the only
# part of the product with a per-call cost (spec 3: a Claude.ai subscription and
# Claude API access are separate products -- this needs a Console key).
#
# Leave it unset and everything else works unchanged; the known-issues section
# then explains its own absence. The bare ANTHROPIC_API_KEY is also accepted.
# NEVER COMMIT A REAL KEY -- backend/.env is gitignored, .env.example is not.
DEAL_RATER_ANTHROPIC_API_KEY=

# Cheapest current Claude model, which is the right tier for recalling
# documented failure modes. CHANGING THIS ALSO MEANS UPDATING THE PER-TOKEN COST
# RATES in backend/app/known_issues/params.py -- a stale rate there does not
# fail, it silently misreports spec 10's cost-per-evaluation figure.
DEAL_RATER_KNOWN_ISSUES_MODEL=claude-haiku-4-5

# --- Accounts and saved evaluations ----------------------------------------
#
# Magic-link sign-in only: an emailed code is exchanged for a session token.
# There is no password anywhere in this system.
#
# Unset RESEND_API_KEY means sign-in is DISABLED, not broken: /v1/auth/sign-in
# returns 503 and says so. Everything else -- capture, evaluate, the overlay --
# works exactly as before; only saving is unreachable.
DEAL_RATER_RESEND_API_KEY=

# Must be on a domain verified in Resend, or every send is rejected.
DEAL_RATER_AUTH_FROM_EMAIL=Curbside <login@example.invalid>

# Where the website lives. Used only to build the link in the sign-in email;
# the extension's paste-a-code flow does not need it.
# The apex serves the whole site since the landing page and the app merged.
# `app.` still resolves (it 308s here), so links in already-sent emails work.
DEAL_RATER_APP_BASE_URL=https://curbsidescore.com

DEAL_RATER_MAGIC_LINK_TTL_MINUTES=15
DEAL_RATER_MAGIC_LINK_MAX_ATTEMPTS=5
DEAL_RATER_SESSION_TTL_DAYS=90

# COOKIE TRANSPORT (the website's session).
#
# The leading dot matters: api.curbsidescore.com SETS the cookie and
# app.curbsidescore.com must be able to READ it, which a host-only cookie
# cannot do. Leave it EMPTY for local development, where a host-only cookie on
# localhost is what you want.
#
# Getting this wrong has one symptom and it is not obvious: sign-in appears to
# succeed and the user is immediately signed out again. The API logs which
# value is in force at startup.
DEAL_RATER_SESSION_COOKIE_NAME=curbside_session
DEAL_RATER_SESSION_COOKIE_DOMAIN=.curbsidescore.com

# Kill switch independent of the key, so the call can be disabled for a
# deployment without stripping credentials out of it.
DEAL_RATER_KNOWN_ISSUES_ENABLED=true
