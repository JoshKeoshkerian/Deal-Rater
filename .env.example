# Copy to backend/.env for local development.

DEAL_RATER_DATABASE_URL=postgresql+psycopg://dealrater:dealrater@localhost:5432/dealrater

# Retention window for observation data (spec 8.2). Rows older than this are
# removed by `python -m app.retention`. Set deliberately; there is no default
# that is right for every deployment.
DEAL_RATER_RETENTION_DAYS=400

# Origins allowed to POST captures. The unpacked extension's origin is
# chrome-extension://<id>, printed by chrome://extensions after loading.
DEAL_RATER_CORS_ORIGINS=["chrome-extension://REPLACE_WITH_EXTENSION_ID","http://localhost:5173"]
