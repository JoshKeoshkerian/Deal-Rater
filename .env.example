# Copy to backend/.env for local development.

DEAL_RATER_DATABASE_URL=postgresql+psycopg://dealrater:dealrater@localhost:5432/dealrater

# Retention window for observation data (spec 8.2). Rows older than this are
# removed by `python -m app.retention`. Set deliberately; there is no default
# that is right for every deployment.
DEAL_RATER_RETENTION_DAYS=400

# Origins allowed to POST captures. The unpacked extension's origin is
# chrome-extension://<id>, printed by chrome://extensions after loading.
DEAL_RATER_CORS_ORIGINS=["chrome-extension://REPLACE_WITH_EXTENSION_ID","http://localhost:5173"]

# Spec 6.6: the one LLM call, for qualitative known issues. This is the only
# part of the product with a per-call cost (spec 3: a Claude.ai subscription and
# Claude API access are separate products -- this needs a Console key).
#
# Leave it unset and everything else works unchanged; the known-issues section
# then explains its own absence. The bare ANTHROPIC_API_KEY is also accepted.
# NEVER COMMIT A REAL KEY -- backend/.env is gitignored, .env.example is not.
DEAL_RATER_ANTHROPIC_API_KEY=

# Cheapest current Claude model, which is the right tier for recalling
# documented failure modes. CHANGING THIS ALSO MEANS UPDATING THE PER-TOKEN COST
# RATES in backend/app/known_issues/params.py -- a stale rate there does not
# fail, it silently misreports spec 10's cost-per-evaluation figure.
DEAL_RATER_KNOWN_ISSUES_MODEL=claude-haiku-4-5

# Kill switch independent of the key, so the call can be disabled for a
# deployment without stripping credentials out of it.
DEAL_RATER_KNOWN_ISSUES_ENABLED=true
